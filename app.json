{
  "expo": {
    "name": "원바이트",
    "slug": "onebite-japanese",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "onebite",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F8F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onebite.japanese"
    },
    "android": {
      "package": "com.onebite.japanese",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F8F8"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "37fbb1971c6cf31cf7d2b8200f6bcb77"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}